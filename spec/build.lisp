(defmacro let+ (defs &rest exps)
  (let* (
	  (temp '())
	  (new-defs (mapcar (lambda (x)
			    (if (eq (car x) '_)
				(let ((sym (gensym)))
				  (push sym temp)
				  `(,sym ,(cadr x)))
				`(,(car x) ,(cadr x))))
			    defs))
	)
    `(let*
       ,new-defs
       (declare ,@(mapcar (lambda (x) `(ignore ,x)) temp))
       ,@exps)
  ))

(defun |#>-reader| (stream sub-char numarg)
  (declare (ignore sub-char numarg))
  (let (chars)
    (do ((curr (read-char stream)
               (read-char stream)))
        ((char= #\newline curr))
      (push curr chars))
    (let ((pattern (nreverse chars))
          output)
      (labels ((match (pos chars)
                 (if (null chars)
                     pos
                     (if (char= (nth pos pattern) (car chars))
                         (match (1+ pos) (cdr chars))
                         (match 0 (cdr (append (subseq pattern 0 pos) chars)))))))
        (do (curr
             (pos 0))
            ((= pos (length pattern)))
          (setf curr (read-char stream)
                pos (match pos (list curr)))
          (push curr output))
        (coerce
         (nreverse
          (nthcdr (length pattern) output))
         'string)))))
(set-dispatch-macro-character #\# #\> #'|#>-reader|)

(defun load-data (filename)
  (let+ (
	 (in (open filename :if-does-not-exist nil))
	 (_ (when (eq in nil) (error "File does not exist.")))
	 (content (read in))
	 (_ (close in))
	 )
	content))

(defconstant spec-data (load-data "spec.lisp"))

(defparameter presets
#>END-DATA
// Autogenerated - Do not modify!

#show heading.where(level: 1): set align(center)
#show heading.where(level: 1): set text(size: 13pt, weight: "bold")
#show heading.where(level: 1): smallcaps
#show heading.where(level: 1): set block(above: 1.5em, below: 1em)

#show outline.entry.where(level: 1): set block(above: 1.0em)
#show outline.entry.where(level: 1): set text(weight: "bold")
#show outline.entry.where(level: 1): set outline.entry(fill: none)
#set outline.entry(fill: pad(left: 0.2em, right: 1em, repeat(
		   gap: 0.50em,
		   [.],
		   )))
#show outline.entry: it => link(
  it.element.location(),
  if it.prefix() == none {
  it.indented(none, it.inner())
  } else {
  it.indented(it.prefix() + h(0.4em), it.inner())
  },
  )
END-DATA)

(defun string-builder (initial)
  (let* (
	 (str "")
	 (dirty t)
	 (str-list '())
	 )
    (labels
	(
	 (lappend (string)
	   (setq dirty t)
	   (push string str-list))
	 (lstringify ()
	   (if dirty
	       (progn
		 (setq dirty nil)
		 (setq str (apply #'concatenate 'string (reverse str-list)))
		 ))
	   str
	   )
	 )
      (push initial str-list)
      (lambda (cmd)
	(case cmd
	  (add (function lappend))
	  (to-string (function lstringify))
	  )))))

(defmacro printf (fmt &rest args)
  (let (
	(fmt-strings) (new-args)
	(new-fmt)
	)
    ; TODO: How to make implicit args like {arg}
    (declare (ignore new-args))
    (map nil
	  (lambda (x) (cond
			((eq x #\{ ) (push "~w" fmt-strings))
			((eq x #\} ) nil)
			(t (push (string x) fmt-strings))
			))
	  fmt
	  )
    (setq new-fmt (apply #'concatenate 'string (reverse fmt-strings)))
    `(write (format nil ,new-fmt ,@args))))

(defun is-node? (node kind)
  (if (not (symbolp kind))
      (error "The kind of a node must be a symbol."))
  (if (not (consp node))
      (error (format nil "The node ~w is not a list." node)))
  (if (eq (car node) kind) t nil))

(defun find-list (list pred)
  (if (funcall pred (car list))
      (car list)
      (find-list (cdr list) pred)))

(defun get-node (doc node)
  (find-list doc (lambda (x) (is-node? x node))))

(defun data->typst (data)
  (let+
    (
    (sb (string-builder presets))
    )
    (labels
      (
       (add (arg) (funcall (funcall sb 'add) arg))
      )
      (add (format nil "~%title: ~a" (cadr (get-node data 'title))))
      (write (funcall (funcall sb 'to-string)))
    )
))
