(import (chicken.file))
(import (chicken.process))

(define (assert cond msg)
  (if cond
      '()
      (error msg)))

(define (xml-value->string value)
  (cond
    ((string? value) value)
    ((symbol? value) (symbol->string value))
    ((number? value) (number->string value))
    ((boolean? value) (if value "true" "false"))
    (else
     (error "Invalid XML attribute value."))))

(define (convert-keys keys)
  (assert (even? (length keys))
          "XML keys must be key/value pairs.")

  (if (null? keys)
      ""
      (let ((key (car keys))
            (value (cadr keys)))
        (assert (symbol? key)
                "XML attribute name must be a symbol.")

        (string-append
         " "
         (symbol->string key)
         "=\""
         (xml-value->string value)
         "\""
         (convert-keys (cddr keys))))))

(define (data->xml list)
  (define (convert-indent list indent)
    (if (or (symbol? list) (string? list) (number? list))
      (let
        ((ind (make-string (* indent 4) #\space )))
        (string-append ind (xml-value->string list)))
      (let*
        (
          (ind (make-string (* indent 4) #\space ))
          (first (car list))
          (_ (assert (not (list? first)) "Name of an XML-Node can not be a list."))
          (name (symbol->string first))
          (rest (cdr list))
          (has-keys
            (and
              (not (null? rest))
              (pair? (car rest))
              (eq? (car (car rest)) '=)))
          (keys (if has-keys
            (convert-keys (cdr (car rest)))
            ""))
          (children (if has-keys
            (cdr rest)
            rest))
        )

        (string-append
          ind "<" name keys ">"
          (apply string-append
		 (map (lambda (x) (string-append "\n" (convert-indent x (+ indent 1)))) children))
          "\n" ind "</" name ">"
        )
      )
    )
  )
  (convert-indent list 0)
)

(define (parse data)
  (define (find data id)
    (cond
      ((not (pair? data)) #f)
      ((not (pair? (car data))) (find (cdr data) id))
      ((eq? (caar data) id) (cdar data))
      (else (find (cdr data) id))
    )
  )
  (lambda (id)
    (cond
      ((eq? id 'raw-data) data)
      ((eq? id 'title)   (find data 'title))
      ((eq? id 'authors) (find data 'authors))
      ((eq? id 'version) (find data 'version))
      ((eq? id 'date)    (find data 'date))
      ((eq? id 'section) (find data 'section))
      ((eq? id 'rule)    (find data 'rule))
      (else
        (display (symbol->string id))
        (display " is not supported as a document node type.\n")
        #f)
    )
  )
)

(define presets
"// Autogenerated - Do not modify!

#show heading.where(level: 1): set align(center)
#show heading.where(level: 1): set text(size: 13pt, weight: \"bold\")
#show heading.where(level: 1): smallcaps
#show heading.where(level: 1): set block(above: 1.5em, below: 1em)

#show outline.entry.where(level: 1): set block(above: 1.0em)
#show outline.entry.where(level: 1): set text(weight: \"bold\")
#show outline.entry.where(level: 1): set outline.entry(fill: none)
#set outline.entry(fill: pad(left: 0.2em, right: 1em, repeat(
  gap: 0.50em,
  [.],
)))
#show outline.entry: it => link(
  it.element.location(),
  if it.prefix() == none {
    it.indented(none, it.inner())
  } else {
    it.indented(it.prefix() + h(0.4em), it.inner())
  },
)
")

(define (data->typst data)
  (define (get a) (car (data a)))
  (define authors
    (apply string-append
      (map (lambda (x)
             (string-append  "" (cadr x) " "))
           (data 'authors))))
  (define rule-count 0)
  (define (str-element data)
    (cond
     ((eq? (car data) 'rule) (begin (set! rule-count (+ rule-count 1))
				    (cdr data)))
    ))
  (define (str-elements section)
    (string-append (str-element (car section)) (str-elements (cdr section))))
  (define (str-sections raw-data)
    (display raw-data)
    (newline)
    (if (eq? (caar raw-data) 'section)
	(string-append
	  (string-append (cdar raw-data) (str-elements (caddr raw-data)))
	  (str-sections (cdr raw-data)))
	""))

  (let* (
      (str presets)
      (str (string-append str "#align(center, text(size: 20pt, weight: \"bold\", \"" (get 'title) "\"))\n"))
      (str (string-append str "#v(1em)\n"))
      (str (string-append str "#align(center)[Version " (get 'version) " dated " (get 'date) "]\n"))
      (str (string-append str "#v(1em)\n"))
      (str (string-append str "#grid(columns: 1fr, align(center)[" authors "])\n"))
      (str (string-append str "#v(1em)\n"))
      (str (string-append str "#outline(title: [Contents], depth: 2, indent: 1.0em)\n\n"))
      (str (string-append str (str-sections (cdr (data 'raw-data)))))
      )
    str
    ))

(define doc-path "spec.scm")
(define in (open-input-file doc-path))
(define doc-data (read in))
(close-input-port in)

(define get-data (parse doc-data))
(define out-data (data->typst get-data))
(display out-data)

(define out-path "out/spec.typ")
(if (not (file-exists? "out"))
    (create-directory "out"))
(define out (open-output-file out-path))

(display out-data out)
(newline out)
(close-output-port out)
(system (string-append "typst compile " out-path))
